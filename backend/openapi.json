{
  "openapi": "3.1.0",
  "info": {
    "title": "Spawn API",
    "description": "Real-world experiences happening around you in Montréal.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness",
        "description": "The process is up and able to answer HTTP requests. Does not touch the database.",
        "operationId": "liveness_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/spawns": {
      "get": {
        "tags": [
          "spawns"
        ],
        "summary": "Nearby Spawns",
        "description": "Spawns near a point, nearest first, with keyset pagination.",
        "operationId": "nearby_spawns_api_v1_spawns_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90,
              "minimum": -90,
              "description": "Latitude of the user",
              "title": "Lat"
            },
            "description": "Latitude of the user"
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180,
              "minimum": -180,
              "description": "Longitude of the user",
              "title": "Lng"
            },
            "description": "Longitude of the user"
          },
          {
            "name": "radius_m",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 25000,
              "exclusiveMinimum": 0,
              "default": 5000,
              "title": "Radius M"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SpawnType"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Repeat to allow several types",
              "title": "Type"
            },
            "description": "Repeat to allow several types"
          },
          {
            "name": "live_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Only spawns happening right now",
              "default": false,
              "title": "Live Only"
            },
            "description": "Only spawns happening right now"
          },
          {
            "name": "days_ahead",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 60,
              "minimum": 0,
              "description": "Include spawns starting this soon",
              "default": 7,
              "title": "Days Ahead"
            },
            "description": "Include spawns starting this soon"
          },
          {
            "name": "include_children",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Also include events aimed specifically at young children",
              "default": false,
              "title": "Include Children"
            },
            "description": "Also include events aimed specifically at young children"
          },
          {
            "name": "free",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Only free spawns",
              "default": false,
              "title": "Free"
            },
            "description": "Only free spawns"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "next_cursor from the previous page",
              "title": "Cursor"
            },
            "description": "next_cursor from the previous page"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NearbyPage"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/v1/spawns/{spawn_id}": {
      "get": {
        "tags": [
          "spawns"
        ],
        "summary": "Get Spawn",
        "operationId": "get_spawn_api_v1_spawns__spawn_id__get",
        "parameters": [
          {
            "name": "spawn_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Spawn Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpawnOut"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sources": {
      "get": {
        "tags": [
          "spawns"
        ],
        "summary": "List Sources",
        "description": "Data sources, their license, how many spawns they currently provide, and last successful run.",
        "operationId": "list_sources_api_v1_sources_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SourceOut"
                  },
                  "type": "array",
                  "title": "Response List Sources Api V1 Sources Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ingestion-runs": {
      "get": {
        "tags": [
          "spawns"
        ],
        "summary": "List Ingestion Runs",
        "description": "Most recent ingestion runs first, with their counts.",
        "operationId": "list_ingestion_runs_api_v1_ingestion_runs_get",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IngestionRunOut"
                  },
                  "title": "Response List Ingestion Runs Api V1 Ingestion Runs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
